{
    "name": "enterprise/hr-payroll-system",
    "description": "Standalone Enterprise HR & Payroll System with Native PHP OOP, MVC, and ZKTeco Biometric Integration",
    "type": "project",
    "license": "Proprietary",
    "authors": [
        {
            "name": "Enterprise Architecture Team",
            "email": "architecture@enterprise.local"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\": "database/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate.php",
        "seed": "php bin/seed.php",
        "sync-biometric": "php bin/sync-attendance.php",
        "calculate-attendance": "php bin/calculate-attendance.php"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
