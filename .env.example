# Application Configuration
APP_NAME="Enterprise HR & Payroll System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/test-folder/public
APP_TIMEZONE=Asia/Riyadh
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_payroll_system
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Session & Security
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax
CSRF_PROTECTION=true
RATE_LIMIT_LOGIN_MAX_ATTEMPTS=5
RATE_LIMIT_LOCKOUT_MINUTES=15

# Biometric Integration Defaults
ZKTECO_DEFAULT_PORT=4370
ZKTECO_CONNECTION_TIMEOUT=5
ZKTECO_UDP_RETRIES=3
ZKTECO_ADMS_AUTH_KEY=enterprise_adms_secret_token_2026

# Attendance Policies Defaults
ATTENDANCE_GRACE_PERIOD_MINUTES=15
ATTENDANCE_HALF_DAY_THRESHOLD_HOURS=4.0
ATTENDANCE_FULL_DAY_HOURS=8.0
OVERTIME_MINIMUM_MINUTES=30
OVERTIME_REGULAR_MULTIPLIER=1.5
OVERTIME_REST_DAY_MULTIPLIER=2.0
OVERTIME_HOLIDAY_MULTIPLIER=2.5

# Payroll Defaults
PAYROLL_CURRENCY=SAR
PAYROLL_CURRENCY_SYMBOL="ر.س"
PAYROLL_DECIMAL_PRECISION=2
PAYROLL_DEFAULT_DAYS_PER_MONTH=30
PAYROLL_HOURS_PER_DAY=8
